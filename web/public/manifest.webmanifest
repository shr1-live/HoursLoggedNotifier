{
  "name": "Hours Logged",
  "short_name": "Hours",
  "description": "Track logged hours against the daily and weekly marks.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f5f5f7",
  "theme_color": "#0066cc",
  "orientation": "any",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Focus window",
      "short_name": "Focus",
      "url": "/?focus=1"
    },
    {
      "name": "Mini widget",
      "short_name": "Widget",
      "url": "/?mini=1"
    }
  ]
}
